rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /** Utility helpers **/
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin check (production-safe)
    // Preferred production method: set a custom claim `admin:true` on the Firebase user
    // (using the Admin SDK). This is safer and avoids editing rules for each admin change.
    // For rollout we keep the existing hard-coded email list as a temporary fallback.
    function isAdmin() {
      return isAuthenticated() && (
        // Primary: custom claim set via admin SDK
        request.auth.token.admin == true
        // Fallback: legacy hard-coded admin emails (for roll-out only)
        || (request.auth.token.email in [
          'n.bi2993@gmail.com',
          'luvyoga.official@gmail.com'
        ])
      );
    }

    // --- QUY TẮC CŨ: Dành cho Bảng tin Trạng thái (statuses) ---
    match /artifacts/{appId}/public/data/statuses/{document=**} {
      // Cho phép BẤT KỲ AI (kể cả chưa đăng nhập) được đọc (read)
      allow read: if true;

      // Cho phép BẤT KỲ AI tạo trạng thái mới với một số điều kiện
      allow create: if request.resource.data.keys().hasAll(['name', 'content', 'timestamp', 'userId'])
                        && request.resource.data.content is string
                        && request.resource.data.content.size() <= 1500
                        && request.resource.data.name.size() <= 100
                        && request.resource.data.timestamp == request.time;
      
      // Không cho phép cập nhật hay xóa
      allow update, delete: if false; 
    }

    // --- QUY TẮC MỚI: Dành cho Blog (blogs) ---
    match /artifacts/{appId}/public/data/blogs/{document=**} {
      // Cho phép BẤT KỲ AI đọc bài blog
      allow read: if true;

      // Cho phép BẤT KỲ AI tạo bài blog mới với một số điều kiện
      allow create: if request.resource.data.keys().hasAll(['title', 'author', 'content', 'imageUrl', 'topics', 'timestamp'])
                        && request.resource.data.title is string && request.resource.data.title.size() <= 200
                        && request.resource.data.author is string && request.resource.data.author.size() <= 100
                        && request.resource.data.content is string && request.resource.data.content.size() <= 10000 // Giới hạn 10,000 ký tự cho bài blog
                        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 1000
                        && request.resource.data.topics is list
                        && request.resource.data.timestamp == request.time;

      // Không cho phép cập nhật hay xóa trong giai đoạn này
      allow update, delete: if false;
    }

    // --- QUY TẮC MẶC ĐỊNH: Dành cho dữ liệu riêng tư (không thay đổi) ---
    match /artifacts/{appId}/users/{userId}/{documents=**} {
      allow read, write: if request.auth.uid != null && request.auth.uid == userId;
    }

    // --- Users collection ---
    // Each authenticated user may create/read/update their own user document
    // and an admin may read/write any user doc. Users may store any fields
    // under their own document ("Lưu mọi thông tin người dùng").
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Allow each user to store private AI/chat metadata and history under a sub-collection.
    match /users/{userId}/aivy/{docId} {
      allow create, read, update: if isAuthenticated() && request.auth.uid == userId;
      // allow deletion by owner or admin
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // --- Classes collection ---
    // Read by anyone; only admins can create/update/delete class master-docs.
    // Students can create a booking under /classes/{classId}/students/{studentId}
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /students/{studentId} {
        // A logged-in user may create a booking document for themselves only
        allow create: if isAuthenticated() && request.auth.uid == studentId;
        // Owner or admin may read / update / delete
        allow read, update, delete: if isAuthenticated() && (request.auth.uid == studentId || isAdmin());
      }
    }

    // --- Payments collection ---
    // Users may create payment documents for themselves; admins manage payments.
    match /payments/{paymentId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        // Validation: amount must be positive number
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0 &&
        // Validation: required fields
        request.resource.data.currency is string &&
        request.resource.data.description is string &&
        request.resource.data.date is string;
      
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Allow users to update payment confirmation fields (memberConfirmed, methodConfirmed, memberConfirmedAt) — admins can update everything
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        // User can update: methodConfirmed, memberConfirmed, memberConfirmedAt (but NOT status, amount)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['methodConfirmed', 'memberConfirmed', 'memberConfirmedAt', 'updatedAt']) &&
        request.resource.data.methodConfirmed in ['Cash', 'Transfer', null]
      );
      
      allow delete: if isAdmin();
    }

    // --- Notifications collection ---
    // Users may create personal notifications.
    // Admin-only notifications (adminOnly: true) can only be read/written by admins.
    // Users can only read their own notifications unless they are admin.
    match /notifications/{notifId} {
      allow create: if isAuthenticated() && (
        // Personal notification: must be for current user
        (request.resource.data.adminOnly != true && request.resource.data.userId == request.auth.uid)
        // Admin-only notification: only admins can create
        || (request.resource.data.adminOnly == true && isAdmin())
      );
      
      allow read: if isAuthenticated() && (
        // Admin can read all notifications
        isAdmin()
        // User can read their own notifications
        || resource.data.userId == request.auth.uid
        // Non-admin cannot read admin-only notifications
      );
      
      allow update, delete: if isAuthenticated() && (
        // Only admins can update/delete admin notifications
        (resource.data.adminOnly == true && isAdmin())
        // User can update/delete their own notifications
        || (resource.data.adminOnly != true && resource.data.userId == request.auth.uid)
      );
    }

    // --- Data deletion requests (for GDPR/Facebook flow) ---
    // Allow users (authenticated) to create an entry and admins to manage them.
    // Also allow unauthenticated creation when a plain email is provided (used by public deletion form).
    match /dataDeletionRequests/{reqId} {
      allow create: if (
        // require an email string
        request.resource.data.email is string &&
        (
          // authenticated users may create (and their userId must match when present)
          (isAuthenticated() && (request.resource.data.userId == null || request.resource.data.userId == request.auth.uid))
          // OR unauthenticated requests are allowed as long as email is given
          || !isAuthenticated()
        )
      );

      allow read, update, delete: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // --- Admin-only collection ---
    match /admin/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Webhook events (audit) - admins may read/write
    match /webhookEvents/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Admin notifications created by backend or webhook processor
    match /adminNotifications/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Audit logs - admins can read only
    match /auditLogs/{doc=**} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Admin configuration (email settings, etc.)
    match /adminConfig/{doc=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Invoices collection ---
    // Members can create and read their own invoices
    // Admins can read all invoices and approve/mark them
    match /invoices/{invoiceId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.paymentId is string &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        // Allow all standard invoice fields
        request.resource.data.keys().hasAll(['id', 'paymentId', 'userId', 'amount']) &&
        request.resource.data.keys().hasOnly([
          'id', 'paymentId', 'userId', 'userName', 'userEmail', 'userPhone',
          'amount', 'currency', 'date', 'description', 'status', 'method',
          'createdAt', 'viewedBy', 'approvedBy', 'approvedAt', 'notes'
        ]);
      
      allow read: if isAuthenticated() && (
        // User can read their own invoices
        resource.data.userId == request.auth.uid ||
        // Admin can read all invoices
        isAdmin()
      );
      
      allow update: if isAdmin() && (
        // Admin can update: approvedBy, approvedAt, notes, viewedBy
        request.resource.data.keys().hasOnly([
          'id', 'paymentId', 'userId', 'userName', 'userEmail', 'userPhone',
          'amount', 'currency', 'date', 'description', 'status', 'method',
          'createdAt', 'viewedBy', 'approvedBy', 'approvedAt', 'notes'
        ])
      );
      
      allow delete: if isAdmin();
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}